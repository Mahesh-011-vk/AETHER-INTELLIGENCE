# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Providers (ordered by priority: Gemini -> Groq -> DeepSeek)
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# GitHub API for repository metrics (optional, increases rate limits)
GITHUB_TOKEN=

# Google Sheets Export (optional)
# Path to Google Service Account JSON file
GOOGLE_APPLICATION_CREDENTIALS=
# Target Google Spreadsheet ID
GOOGLE_SPREADSHEET_ID=

# Database
DATABASE_URL=sqlite:///data/ai_pipeline.db

# Pipeline Concurrency & Freshness Settings
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
BACKOFF_FACTOR=1.5
ROLLING_WINDOW_HOURS=24
RAPIDFUZZ_SIMILARITY_THRESHOLD=85.0

